# New project uploads use Cloudinary; keep AWS values for existing Neon images.
# Public uploads: cloud name + unsigned upload preset.
# Signed uploads and permanent file cleanup also require valid API credentials.
CLOUDINARY_UPLOAD_PRESET=rob_arch
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEON_FUNCTION_HELLO_BASE_URL=
STUDIO_FUNCTION_SECRET=
INQUIRY_HASH_SECRET=
NEON_REALTIME_URL=
