{
  "name": "rob-architects",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "npm run typecheck && npm run lint && npm run format:check && node scripts/check-next.cjs",
    "test:browser": "node scripts/smoke-next.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:database": "node scripts/test-database.cjs",
    "test:admin": "node --env-file=.env.local scripts/test-neon-e2e.cjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate-neon.cjs",
    "test:neon": "node --env-file=.env.local scripts/test-neon-e2e.cjs",
    "test:realtime": "node --env-file=.env.local scripts/test-realtime-lifecycle.cjs",
    "test:images": "node scripts/test-project-images.cjs",
    "test:admin-hosts": "node scripts/test-admin-hosts.cjs",
    "test:image-loading": "node scripts/test-image-loading.cjs",
    "test:intro": "node scripts/test-intro-loading.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@neon/auth": "0.8.2",
    "@neon/config": "^1.10.1",
    "@neon/env": "^1.6.9",
    "@neon/functions": "0.11.0",
    "@neon/realtime": "0.1.2",
    "@neon/realtime-react": "0.1.1",
    "@vercel/functions": "3.10.6",
    "cloudinary": "^2.11.0",
    "gsap": "^3.15.0",
    "lucide-react": "1.68.0",
    "next": "^16.4.4",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "parse5": "^8.1.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
